# Dependencies
node_modules/

# Build artifacts (generated by `npm run build:frontend`)
frontend/public/bundle.js
frontend/public/bundle.js.map
dist/

# Wrangler local state / dev caches
.wrangler/
worker/.wrangler/
tools/**/.wrangler/
.mf/

# Environment / secrets — never committed
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
wrangler.toml.local

# Bootstrap account credentials (generated locally, shown once) — never committed
tools/bootstrap-accounts/*.local.*
tools/bootstrap-accounts/*.sql

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*

# Test/coverage output
coverage/

# D1 pre-migration backups/exports (Engineering skill §24 DATA-004) — local
# safety copies only, never committed (may contain real learner data later).
backups/
